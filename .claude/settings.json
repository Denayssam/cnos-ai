{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/precompile-guard.sh\"",
            "shell": "bash",
            "timeout": 180,
            "statusMessage": "Verifying TypeScript build before commit/package…"
          }
        ]
      }
    ]
  }
}
